# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Dodo Payments: test key on Preview/local, live key on Production
# (live mode is automatic on Vercel production, see src/lib/server/env.ts)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# protects /api/cron/auto-refund
CRON_SECRET=

# Resend: connect emails (Phase 5G). Without it nothing is emailed.
RESEND_API_KEY=

# Live city room server (Phase 8A, realtime/). Unset = no live positions; the game works as before.
# local: npm run rt:dev → http://localhost:8787 · Vercel: Production → prod worker, Preview/Development → staging
NEXT_PUBLIC_REALTIME_URL=
